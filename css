/* ============================================================
   PETCHIP - Sistema de diseno institucional
   Paleta: azul PetChip (identificacion) + verde (salud/naturaleza)
   Tipografia: Poppins (titulos) / Inter (texto)
============================================================ */

:root{
  --pc-blue-900:#0d2b4e;
  --pc-blue-800:#123a63;
  --pc-blue-700:#1a4f85;
  --pc-blue-600:#1976d2;
  --pc-blue-500:#2196f3;
  --pc-blue-100:#e3f2fd;
  --pc-green-600:#2e9e5b;
  --pc-green-500:#3ab26e;
  --pc-green-100:#e5f7ec;
  --pc-amber-500:#f5a623;
  --pc-red-500:#e5484d;
  --pc-gray-900:#1c2531;
  --pc-gray-700:#4b5768;
  --pc-gray-500:#8592a3;
  --pc-gray-200:#e7ecf2;
  --pc-gray-100:#f4f7fb;
  --pc-white:#ffffff;

  --pc-bg:#f2f5fa;
  --pc-surface:#ffffff;
  --pc-text:#1c2531;
  --pc-text-muted:#67748c;
  --pc-border:#e7ecf2;
  --pc-sidebar-bg:#0d2b4e;
  --pc-sidebar-text:#c9d9ec;
  --pc-sidebar-active:#1976d2;

  --pc-radius-sm:10px;
  --pc-radius-md:16px;
  --pc-radius-lg:22px;
  --pc-shadow-sm:0 2px 8px rgba(13,43,78,.06);
  --pc-shadow-md:0 10px 30px rgba(13,43,78,.10);
  --pc-shadow-lg:0 18px 45px rgba(13,43,78,.16);
  --pc-transition:.22s cubic-bezier(.4,0,.2,1);
}

[data-theme="dark"]{
  --pc-bg:#0f1620;
  --pc-surface:#182230;
  --pc-text:#e7ecf2;
  --pc-text-muted:#93a2b8;
  --pc-border:#26324420;
  --pc-border:#2b3849;
  --pc-sidebar-bg:#0a1420;
  --pc-sidebar-text:#9db3cc;
  --pc-gray-100:#1c2733;
  --pc-gray-200:#2b3849;
  --pc-shadow-sm:0 2px 8px rgba(0,0,0,.25);
  --pc-shadow-md:0 10px 30px rgba(0,0,0,.35);
  --pc-shadow-lg:0 18px 45px rgba(0,0,0,.45);
}

*{ box-sizing:border-box; }

html,body{
  height:100%;
}

body{
  font-family:'Inter', 'Segoe UI', sans-serif;
  background:var(--pc-bg);
  color:var(--pc-text);
  transition:background var(--pc-transition), color var(--pc-transition);
}

h1,h2,h3,h4,h5,h6,.font-title{
  font-family:'Poppins', 'Inter', sans-serif;
  font-weight:600;
  color:var(--pc-text);
}

a{ color:var(--pc-blue-600); }

::selection{ background:var(--pc-blue-100); }

/* ------------------------------------------------------------
   LAYOUT: sidebar + topbar + contenido
------------------------------------------------------------ */
.pc-app{
  display:flex;
  min-height:100vh;
}

.pc-sidebar{
  width:260px;
  flex-shrink:0;
  background:var(--pc-sidebar-bg);
  color:var(--pc-sidebar-text);
  position:fixed;
  top:0; left:0; bottom:0;
  display:flex;
  flex-direction:column;
  z-index:1030;
  transition:transform var(--pc-transition), width var(--pc-transition);
}

.pc-sidebar .pc-brand{
  display:flex;
  align-items:center;
  gap:12px;
  padding:22px 20px;
  border-bottom:1px solid rgba(255,255,255,.08);
}

.pc-sidebar .pc-brand img{
  width:38px; height:38px; object-fit:contain;
}

.pc-sidebar .pc-brand span{
  font-family:'Poppins',sans-serif;
  font-weight:700;
  font-size:1.15rem;
  color:#fff;
}

.pc-nav{
  flex:1;
  overflow-y:auto;
  padding:14px 12px;
}

.pc-nav .pc-nav-section{
  text-transform:uppercase;
  font-size:.68rem;
  letter-spacing:.08em;
  color:rgba(201,217,236,.45);
  margin:18px 12px 8px;
  font-weight:600;
}

.pc-nav a{
  display:flex;
  align-items:center;
  gap:12px;
  padding:11px 14px;
  border-radius:12px;
  color:var(--pc-sidebar-text);
  text-decoration:none;
  font-size:.92rem;
  font-weight:500;
  margin-bottom:3px;
  transition:background var(--pc-transition), color var(--pc-transition), transform var(--pc-transition);
  position:relative;
}

.pc-nav a i{ font-size:1.05rem; width:20px; text-align:center; }

.pc-nav a:hover{
  background:rgba(255,255,255,.08);
  color:#fff;
  transform:translateX(2px);
}

.pc-nav a.active{
  background:var(--pc-sidebar-active);
  color:#fff;
  box-shadow:0 6px 16px rgba(25,118,210,.35);
}

.pc-nav a .badge-count{
  margin-left:auto;
  background:var(--pc-red-500);
  color:#fff;
  font-size:.68rem;
  padding:1px 7px;
  border-radius:20px;
}

.pc-sidebar-footer{
  padding:16px 20px;
  border-top:1px solid rgba(255,255,255,.08);
  font-size:.78rem;
  color:rgba(201,217,236,.55);
}

.pc-main{
  margin-left:260px;
  flex:1;
  min-width:0;
  display:flex;
  flex-direction:column;
  transition:margin var(--pc-transition);
}

.pc-topbar{
  position:sticky;
  top:0;
  z-index:1020;
  background:var(--pc-surface);
  border-bottom:1px solid var(--pc-border);
  padding:14px 24px;
  display:flex;
  align-items:center;
  gap:16px;
  box-shadow:var(--pc-shadow-sm);
}

.pc-topbar .pc-toggle-btn{
  background:var(--pc-gray-100);
  border:none;
  width:40px; height:40px;
  border-radius:10px;
  display:flex;align-items:center;justify-content:center;
  color:var(--pc-text);
  cursor:pointer;
  transition:background var(--pc-transition);
}
.pc-topbar .pc-toggle-btn:hover{ background:var(--pc-gray-200); }

.pc-search-global{
  flex:1;
  max-width:420px;
  position:relative;
}
.pc-search-global input{
  width:100%;
  padding:10px 14px 10px 40px;
  border-radius:12px;
  border:1px solid var(--pc-border);
  background:var(--pc-gray-100);
  color:var(--pc-text);
  font-size:.9rem;
}
.pc-search-global i{
  position:absolute; left:14px; top:50%; transform:translateY(-50%);
  color:var(--pc-text-muted);
}

.pc-topbar-actions{
  margin-left:auto;
  display:flex;
  align-items:center;
  gap:10px;
}

.pc-icon-btn{
  position:relative;
  width:40px; height:40px;
  border-radius:10px;
  background:var(--pc-gray-100);
  border:none;
  display:flex; align-items:center; justify-content:center;
  color:var(--pc-text);
  cursor:pointer;
  text-decoration:none;
  transition:background var(--pc-transition);
}
.pc-icon-btn:hover{ background:var(--pc-gray-200); color:var(--pc-text); }
.pc-icon-btn .dot{
  position:absolute; top:6px; right:6px;
  width:8px; height:8px; border-radius:50%;
  background:var(--pc-red-500);
  border:2px solid var(--pc-surface);
}

.pc-user-chip{
  display:flex; align-items:center; gap:10px;
  padding:6px 12px 6px 6px;
  border-radius:30px;
  background:var(--pc-gray-100);
}
.pc-user-chip .avatar{
  width:30px;height:30px;border-radius:50%;
  background:var(--pc-blue-600);
  color:#fff;
  display:flex;align-items:center;justify-content:center;
  font-weight:600;font-size:.8rem;
  text-transform:uppercase;
}
.pc-user-chip .role-tag{
  font-size:.68rem;
  padding:1px 8px;
  border-radius:20px;
  background:var(--pc-blue-100);
  color:var(--pc-blue-700);
  font-weight:600;
}
[data-theme="dark"] .pc-user-chip .role-tag{ background:#1c3a56; color:#a9cdf0; }

.pc-content{
  padding:26px;
  flex:1;
}

.pc-page-header{
  display:flex;
  align-items:flex-start;
  justify-content:space-between;
  flex-wrap:wrap;
  gap:14px;
  margin-bottom:22px;
}
.pc-page-header h1{
  font-size:1.5rem;
  margin:0 0 4px;
}
.pc-page-header p{
  color:var(--pc-text-muted);
  margin:0;
  font-size:.92rem;
}
.pc-breadcrumb{
  font-size:.8rem;
  color:var(--pc-text-muted);
  margin-bottom:6px;
}
.pc-breadcrumb a{ color:var(--pc-text-muted); text-decoration:none; }
.pc-breadcrumb a:hover{ color:var(--pc-blue-600); }

/* ------------------------------------------------------------
   TARJETAS
------------------------------------------------------------ */
.pc-card{
  background:var(--pc-surface);
  border-radius:var(--pc-radius-md);
  box-shadow:var(--pc-shadow-sm);
  border:1px solid var(--pc-border);
  transition:box-shadow var(--pc-transition), transform var(--pc-transition);
}
.pc-card.hoverable:hover{
  box-shadow:var(--pc-shadow-md);
  transform:translateY(-3px);
}
.pc-card-body{ padding:22px; }
.pc-card-header{
  padding:18px 22px;
  border-bottom:1px solid var(--pc-border);
  display:flex; align-items:center; justify-content:space-between;
}

/* Tarjetas de estadisticas del dashboard */
.pc-stat-card{
  background:var(--pc-surface);
  border-radius:var(--pc-radius-md);
  box-shadow:var(--pc-shadow-sm);
  border:1px solid var(--pc-border);
  padding:20px;
  display:flex;
  align-items:center;
  gap:16px;
  transition:transform var(--pc-transition), box-shadow var(--pc-transition);
  animation:pc-fade-up .5s ease both;
}
.pc-stat-card:hover{ transform:translateY(-4px); box-shadow:var(--pc-shadow-md); }
.pc-stat-icon{
  width:52px; height:52px;
  border-radius:14px;
  display:flex; align-items:center; justify-content:center;
  font-size:1.4rem;
  flex-shrink:0;
}
.pc-stat-value{
  font-family:'Poppins',sans-serif;
  font-size:1.65rem;
  font-weight:700;
  line-height:1.1;
}
.pc-stat-label{
  color:var(--pc-text-muted);
  font-size:.82rem;
  margin-top:2px;
}
.pc-stat-trend{
  font-size:.72rem;
  font-weight:600;
  margin-top:6px;
}

.bg-soft-blue{ background:var(--pc-blue-100); color:var(--pc-blue-700); }
.bg-soft-green{ background:var(--pc-green-100); color:var(--pc-green-600); }
.bg-soft-amber{ background:#fdf0dc; color:#b06a00; }
.bg-soft-red{ background:#fde5e6; color:var(--pc-red-500); }
.bg-soft-purple{ background:#ece3fb; color:#6b3fd4; }
[data-theme="dark"] .bg-soft-blue{ background:#173252; }
[data-theme="dark"] .bg-soft-green{ background:#123424; }
[data-theme="dark"] .bg-soft-amber{ background:#3a2a10; }
[data-theme="dark"] .bg-soft-red{ background:#3a1417; }
[data-theme="dark"] .bg-soft-purple{ background:#251a3d; }

@keyframes pc-fade-up{
  from{ opacity:0; transform:translateY(14px); }
  to{ opacity:1; transform:translateY(0); }
}
.pc-animate{ animation:pc-fade-up .45s ease both; }

/* ------------------------------------------------------------
   BOTONES
------------------------------------------------------------ */
.btn-pc-primary{
  background:var(--pc-blue-600);
  border:none;
  color:#fff;
  font-weight:600;
  border-radius:12px;
  padding:10px 20px;
  transition:background var(--pc-transition), transform var(--pc-transition);
}
.btn-pc-primary:hover{ background:var(--pc-blue-700); color:#fff; transform:translateY(-1px); }

.btn-pc-outline{
  background:transparent;
  border:1.5px solid var(--pc-border);
  color:var(--pc-text);
  font-weight:600;
  border-radius:12px;
  padding:9px 18px;
  transition:all var(--pc-transition);
}
.btn-pc-outline:hover{ border-color:var(--pc-blue-500); color:var(--pc-blue-600); }

.btn-pc-success{ background:var(--pc-green-600); border:none; color:#fff; font-weight:600; border-radius:12px; padding:10px 20px; }
.btn-pc-success:hover{ background:#257a47; color:#fff; }

.btn-pc-danger{ background:var(--pc-red-500); border:none; color:#fff; font-weight:600; border-radius:12px; padding:9px 18px; }
.btn-pc-danger:hover{ background:#c73e42; color:#fff; }

.btn-icon-sm{
  width:34px; height:34px;
  border-radius:9px;
  display:inline-flex; align-items:center; justify-content:center;
  border:1px solid var(--pc-border);
  background:var(--pc-surface);
  color:var(--pc-text);
  transition:all var(--pc-transition);
}
.btn-icon-sm:hover{ background:var(--pc-gray-100); }
.btn-icon-sm.edit:hover{ color:var(--pc-blue-600); border-color:var(--pc-blue-500); }
.btn-icon-sm.delete:hover{ color:var(--pc-red-500); border-color:var(--pc-red-500); }
.btn-icon-sm.view:hover{ color:var(--pc-green-600); border-color:var(--pc-green-600); }

/* ------------------------------------------------------------
   FORMULARIOS
------------------------------------------------------------ */
.pc-form-label{
  font-weight:600;
  font-size:.85rem;
  color:var(--pc-text);
  margin-bottom:6px;
  display:block;
}
.pc-form-control, .form-control, .form-select{
  background:var(--pc-surface);
  border:1.5px solid var(--pc-border);
  color:var(--pc-text);
  border-radius:11px;
  padding:10px 14px;
  font-size:.92rem;
  transition:border-color var(--pc-transition), box-shadow var(--pc-transition);
}
.form-control:focus, .form-select:focus{
  border-color:var(--pc-blue-500);
  box-shadow:0 0 0 3px rgba(33,150,243,.15);
  background:var(--pc-surface);
  color:var(--pc-text);
}
.form-control.is-invalid{ border-color:var(--pc-red-500); }
.invalid-feedback{ font-size:.78rem; }

.pc-photo-drop{
  border:2px dashed var(--pc-border);
  border-radius:16px;
  padding:20px;
  text-align:center;
  cursor:pointer;
  transition:all var(--pc-transition);
  background:var(--pc-gray-100);
}
.pc-photo-drop:hover{ border-color:var(--pc-blue-500); background:var(--pc-blue-100); }
.pc-photo-preview{
  width:96px;height:96px;border-radius:16px;object-fit:cover;
  border:2px solid var(--pc-border);
  box-shadow:var(--pc-shadow-sm);
}

.pc-alert{
  border-radius:14px;
  padding:14px 18px;
  display:flex;
  align-items:center;
  gap:12px;
  font-size:.9rem;
  font-weight:500;
  margin-bottom:18px;
  animation:pc-fade-up .35s ease both;
}
.pc-alert-exito{ background:var(--pc-green-100); color:#1c6e3f; border:1px solid #bfe8cf; }
.pc-alert-error{ background:#fde5e6; color:#9b2b2e; border:1px solid #f6c1c3; }
[data-theme="dark"] .pc-alert-exito{ background:#123424; color:#7fd8a3; border-color:#1e5636; }
[data-theme="dark"] .pc-alert-error{ background:#3a1417; color:#f39a9c; border-color:#5c2226; }

/* ------------------------------------------------------------
   TABLAS
------------------------------------------------------------ */
.pc-table-wrap{
  background:var(--pc-surface);
  border-radius:var(--pc-radius-md);
  box-shadow:var(--pc-shadow-sm);
  border:1px solid var(--pc-border);
  overflow:hidden;
}
.pc-table{ width:100%; border-collapse:collapse; margin:0; }
.pc-table thead th{
  background:var(--pc-gray-100);
  color:var(--pc-text-muted);
  font-size:.72rem;
  text-transform:uppercase;
  letter-spacing:.04em;
  font-weight:700;
  padding:13px 16px;
  text-align:left;
  border-bottom:1px solid var(--pc-border);
  white-space:nowrap;
}
.pc-table tbody td{
  padding:13px 16px;
  border-bottom:1px solid var(--pc-border);
  font-size:.88rem;
  vertical-align:middle;
}
.pc-table tbody tr{ transition:background var(--pc-transition); }
.pc-table tbody tr:hover{ background:var(--pc-gray-100); }
.pc-table tbody tr:last-child td{ border-bottom:none; }

.pc-avatar-sm{
  width:36px;height:36px;border-radius:10px;object-fit:cover;
  border:1px solid var(--pc-border);
}

.badge-estado{
  font-size:.72rem;
  font-weight:600;
  padding:4px 10px;
  border-radius:20px;
  display:inline-block;
}
.badge-activo{ background:var(--pc-green-100); color:var(--pc-green-600); }
.badge-perdido{ background:#fde5e6; color:var(--pc-red-500); }
.badge-encontrado{ background:#fdf0dc; color:#b06a00; }
.badge-fallecido{ background:var(--pc-gray-200); color:var(--pc-gray-700); }
.badge-adoptado{ background:#ece3fb; color:#6b3fd4; }

/* ------------------------------------------------------------
   TIMELINE (linea de tiempo del animal)
------------------------------------------------------------ */
.pc-timeline{ position:relative; padding-left:34px; }
.pc-timeline::before{
  content:"";
  position:absolute; left:10px; top:6px; bottom:6px;
  width:2px; background:var(--pc-border);
}
.pc-timeline-item{ position:relative; padding-bottom:24px; }
.pc-timeline-item::before{
  content:"";
  position:absolute; left:-30px; top:2px;
  width:14px; height:14px; border-radius:50%;
  background:var(--pc-blue-600);
  border:3px solid var(--pc-surface);
  box-shadow:0 0 0 2px var(--pc-blue-100);
}
.pc-timeline-item.vacuna::before{ background:var(--pc-green-600); box-shadow:0 0 0 2px var(--pc-green-100); }
.pc-timeline-item.esterilizacion::before{ background:#6b3fd4; box-shadow:0 0 0 2px #ece3fb; }
.pc-timeline-item.rfid::before{ background:var(--pc-amber-500); box-shadow:0 0 0 2px #fdf0dc; }
.pc-timeline-date{ font-size:.74rem; color:var(--pc-text-muted); font-weight:600; }
.pc-timeline-title{ font-weight:600; margin:2px 0 3px; }
.pc-timeline-desc{ font-size:.85rem; color:var(--pc-text-muted); }

/* ------------------------------------------------------------
   LOGIN
------------------------------------------------------------ */
.pc-login-wrap{
  min-height:100vh;
  display:flex;
  align-items:center;
  justify-content:center;
  background:linear-gradient(160deg, var(--pc-blue-900), var(--pc-blue-700) 60%, var(--pc-green-600));
  padding:20px;
}
.pc-login-card{
  width:100%;
  max-width:420px;
  background:var(--pc-surface);
  border-radius:var(--pc-radius-lg);
  box-shadow:var(--pc-shadow-lg);
  padding:40px 36px;
  animation:pc-fade-up .5s ease both;
}
.pc-login-logo{ width:76px; height:76px; object-fit:contain; margin:0 auto 14px; display:block; }
.pc-login-card h1{ text-align:center; font-size:1.6rem; margin-bottom:4px; }
.pc-login-card .subtitle{ text-align:center; color:var(--pc-text-muted); font-size:.85rem; margin-bottom:26px; line-height:1.5; }
.pc-input-icon{ position:relative; }
.pc-input-icon i{ position:absolute; left:14px; top:50%; transform:translateY(-50%); color:var(--pc-text-muted); }
.pc-input-icon input{ padding-left:40px; }
.pc-demo-users{
  margin-top:22px; padding-top:18px; border-top:1px solid var(--pc-border);
  font-size:.76rem; color:var(--pc-text-muted);
}
.pc-demo-users table{ width:100%; margin-top:6px; }
.pc-demo-users td{ padding:2px 4px; }

/* ------------------------------------------------------------
   MISC
------------------------------------------------------------ */
.pc-empty-state{
  text-align:center;
  padding:60px 20px;
  color:var(--pc-text-muted);
}
.pc-empty-state i{ font-size:2.6rem; color:var(--pc-gray-500); margin-bottom:14px; display:block; }

.pc-quick-link{
  display:flex; align-items:center; gap:14px;
  padding:16px;
  border-radius:14px;
  border:1px solid var(--pc-border);
  text-decoration:none;
  color:var(--pc-text);
  transition:all var(--pc-transition);
  height:100%;
}
.pc-quick-link:hover{ border-color:var(--pc-blue-500); background:var(--pc-blue-100); color:var(--pc-text); transform:translateY(-2px); }
[data-theme="dark"] .pc-quick-link:hover{ background:#173252; }
.pc-quick-link .qi{
  width:42px;height:42px;border-radius:12px;
  display:flex;align-items:center;justify-content:center;
  font-size:1.15rem; flex-shrink:0;
}

.pc-modal-backdrop-blur{ backdrop-filter:blur(2px); }

/* Responsive */
@media (max-width: 991.98px){
  .pc-sidebar{ transform:translateX(-100%); }
  .pc-sidebar.open{ transform:translateX(0); box-shadow:var(--pc-shadow-lg); }
  .pc-main{ margin-left:0; }
  .pc-search-global{ display:none; }
}

@media print{
  .pc-sidebar, .pc-topbar, .no-print{ display:none !important; }
  .pc-main{ margin-left:0 !important; }
  body{ background:#fff; }
}

.pc-scroll-thin::-webkit-scrollbar{ width:6px; }
.pc-scroll-thin::-webkit-scrollbar-thumb{ background:rgba(255,255,255,.15); border-radius:10px; }